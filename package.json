{
  "name": "neon-heist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/engine.test.ts tests/http.test.ts",
    "test:integration": "tsx --test tests/database.test.ts",
    "test:security": "tsx --test tests/security.test.ts",
    "test:http": "tsx --test tests/http-api.test.ts",
    "test:supabase": "node --env-file=.env.local scripts/supabase-smoke.mjs",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "local:setup": "node scripts/local-setup.mjs",
    "local:stop": "node scripts/local-stop.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
