# Run `npm run local:setup` to generate a local configuration automatically.
NEON_AUTH_MODE=local
NEXT_PUBLIC_NEON_AUTH_MODE=local
DATABASE_URL=postgresql://neon_heist@127.0.0.1:55432/neon_heist
DATABASE_SSL=false

# Supabase configuration (required for the production build).
# NEON_AUTH_MODE=supabase
# NEXT_PUBLIC_NEON_AUTH_MODE=supabase
# DATABASE_URL=<Supabase transaction pooler connection string, port 6543>
# DATABASE_SSL=true
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional: PEM certificate if your database needs an additional trust root.
# DATABASE_CA_CERT=

# Local identity must never be enabled on Vercel.
